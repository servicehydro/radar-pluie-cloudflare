{
  "name": "radar-pluie-test",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",

  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
